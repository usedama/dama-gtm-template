setup: |-
  const mockData = {
    eventType: 'init',
    damaId: 'ORG-1',
    damaToken: 'tok-1',
    region: 'custom',
    collectUrl: 'https://collect.example.com',
    sendSessionStart: true,
    consentMode: 'gtm',
    gtmOnSuccess: function () {},
    gtmOnFailure: function () {}
  };

  let injectedUrls = [];
  let queue = [];
  let calls = [];
  let windowValues = {};
  let dataLayerEcommerce;
  let storage = {};

  mock('injectScript', function (url, onSuccess, onFailure, cacheToken) {
    injectedUrls.push(url);
    windowValues.damaDP = windowValues.damaDP || function () {};
    onSuccess();
  });
  mock('copyFromWindow', function (key) { return windowValues[key]; });
  mock('createQueue', function (key) {
    return function (entry) { queue.push(entry); };
  });
  mock('callInWindow', function (path, a, b, c) { calls.push([path, a, b, c]); });
  mock('copyFromDataLayer', function (key) { return key === 'ecommerce' ? dataLayerEcommerce : undefined; });
  mock('getCookieValues', function (name) { return []; });
  mock('isConsentGranted', function (type) { return true; });
  mockObject('templateStorage', {
    getItem: function (key) { return storage[key]; },
    setItem: function (key, value) { storage[key] = value; },
    removeItem: function (key) { storage[key] = undefined; }
  });


