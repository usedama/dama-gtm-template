const callInWindow = require('callInWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const copyFromWindow = require('copyFromWindow');
const createQueue = require('createQueue');
const encodeUriComponent = require('encodeUriComponent');
const getCookieValues = require('getCookieValues');
const getType = require('getType');
const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const JSON = require('JSON');
const log = require('logToConsole');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const makeTableMap = require('makeTableMap');
const Object = require('Object');
const templateStorage = require('templateStorage');

const SDK_URL = 'https://cdn.usedama.com/dama.js';
// Collection address of each shared DAMA location. Add a location here and in
// the "Data location" field when DAMA opens one.
const REGION_COLLECT_URLS = {
  eu: 'https://eu-1.usedama.com'
};
const SDK_CACHE_TOKEN = 'dama-sdk';
const SDK_URL_STORAGE_KEY = 'damaSdkUrl';
const SESSION_COOKIE = 'damadp_session_id';
const LOG_PREFIX = '[DAMA] ';

const ECOMMERCE_EVENTS = [
  'view_item_list', 'view_item', 'add_to_cart', 'remove_from_cart',
  'view_cart', 'begin_checkout', 'add_payment_info', 'purchase'
];
const CUSTOMER_EVENTS = ['begin_checkout', 'add_payment_info', 'purchase'];
// GA4 ecommerce keys copied from the data layer. Anything else in the
// ecommerce object is left out so the event stays within DAMA's limits.
const ECOMMERCE_KEYS = [
  'currency', 'value', 'items', 'transaction_id', 'affiliation', 'coupon',
  'shipping', 'tax', 'payment_type', 'shipping_tier', 'item_list_id',
  'item_list_name'
];
// Plain-text personal data makes DAMA reject the whole event. These belong
// in Customer Details, which the SDK hashes in the browser.
const PERSONAL_DATA_KEYS = [
  'user_email', 'user_phone', 'user_name', 'user_first_name', 'user_last_name',
  'customer_email', 'customer_phone', 'customer_first_name', 'customer_last_name',
  'email', 'phone'
];

function warn(message) {
  log(LOG_PREFIX + message);
}

function fail(message) {
  warn(message);
  data.gtmOnFailure();
}

function contains(list, value) {
  return list.indexOf(value) !== -1;
}

function isEmpty(value) {
  return value === undefined || value === null || value === '';
}

function trim(value) {
  return isEmpty(value) ? '' : makeString(value).trim();
}

function isSdkLoaded() {
  return getType(copyFromWindow('damaDP')) === 'function';
}

// Calls damaDP once the SDK has started and queues the call before that.
// The SDK starts itself on the first damaDP() call, reading its settings from
// the script that is running at that moment. Called from GTM, that is gtm.js,
// whose ?id=GTM-XXXX would be read as the organization ID. Queued calls are
// sent by the SDK as soon as it has started from its own script tag.
function send(command, arg1, arg2) {
  if (copyFromWindow('damaDPInitInProgress') === false) {
    callInWindow('damaDP', command, arg1, arg2);
  } else {
    createQueue('damaDP.q')([command, arg1, arg2]);
  }
}

// Runs onReady once damaDP exists. If the base tag on this page has started
// loading the SDK, waits for that same request instead of loading it again.
function withSdk(onReady) {
  if (isSdkLoaded()) {
    onReady();
    return;
  }
  const sdkUrl = templateStorage.getItem(SDK_URL_STORAGE_KEY);
  if (!sdkUrl) {
    fail('The DAMA SDK is not loaded on this page. Add a DAMA tag of type "Base tag" ' +
         'that fires on Initialization - All Pages, or fire it before this tag with tag sequencing.');
    return;
  }
  injectScript(sdkUrl, onReady, function () {
    fail('The DAMA SDK failed to load from ' + SDK_URL + '.');
  }, SDK_CACHE_TOKEN);
}

function isGranted(value) {
  const text = trim(value).toLowerCase();
  return text === 'true' || text === 'granted' || text === '1' || text === 'yes';
}

// DAMA's consent flags in order: essential, ads, analytics.
function buildConsents() {
  const mode = data.consentMode || 'gtm';
  if (mode === 'none') {
    return '';
  }
  let ads;
  let analytics;
  if (mode === 'manual') {
    ads = isGranted(data.consentAds);
    analytics = isGranted(data.consentAnalytics);
  } else {
    ads = isConsentGranted('ad_user_data') && isConsentGranted('ad_personalization');
    analytics = isConsentGranted('analytics_storage');
  }
  return 'true,' + makeString(ads) + ',' + makeString(analytics);
}

function runBaseTag() {
  const damaId = trim(data.damaId);
  const damaToken = trim(data.damaToken);
  // Tags saved before "Data location" existed carry only collectUrl.
  const region = data.region || (trim(data.collectUrl) ? 'custom' : 'eu');
  let collectUrl = region === 'custom' ? trim(data.collectUrl) : (REGION_COLLECT_URLS[region] || '');
  while (collectUrl.length > 0 && collectUrl.charAt(collectUrl.length - 1) === '/') {
    collectUrl = collectUrl.slice(0, -1);
  }

  if (!damaId || !damaToken) {
    fail('Organization ID and Tracking Token are required.');
    return;
  }
  // Required: without collect= the SDK falls back to a legacy address that is being retired.
  if (collectUrl.indexOf('https://') !== 0 || collectUrl.length <= 8) {
    fail(region === 'custom' ?
      'Collection URL must be an https:// address, for example https://collect.yourbrand.com' :
      'Unknown data location "' + region + '".');
    return;
  }

  if (templateStorage.getItem(SDK_URL_STORAGE_KEY)) {
    warn('The base tag already ran on this page; the SDK is loaded once per page.');
    data.gtmOnSuccess();
    return;
  }
  if (isSdkLoaded()) {
    warn('damaDP already exists on this page (the SDK was added outside this tag). ' +
         'Not loading it again; remove one of the two installations.');
    data.gtmOnSuccess();
    return;
  }

  // Read before the SDK starts: the SDK creates this cookie for a new session.
  const isNewSession = data.sendSessionStart !== false &&
    getCookieValues(SESSION_COOKIE).length === 0;

  let sdkUrl = SDK_URL +
    '?id=' + encodeUriComponent(damaId) +
    '&token=' + encodeUriComponent(damaToken) +
    '&collect=' + encodeUriComponent(collectUrl);
  const consents = buildConsents();
  if (consents) {
    sdkUrl = sdkUrl + '&consents=' + consents;
  }
  templateStorage.setItem(SDK_URL_STORAGE_KEY, sdkUrl);

  injectScript(sdkUrl, function () {
    if (isNewSession) {
      send('event', 'session_start');
    }
    data.gtmOnSuccess();
  }, function () {
    templateStorage.removeItem(SDK_URL_STORAGE_KEY);
    fail('The DAMA SDK failed to load from ' + SDK_URL + '. Check that the page can reach it.');
  }, SDK_CACHE_TOKEN);
}

function addParams(target, rows) {
  if (getType(rows) !== 'array' || rows.length === 0) {
    return;
  }
  const params = makeTableMap(rows, 'name', 'value') || {};
  Object.keys(params).forEach(function (key) {
    if (contains(PERSONAL_DATA_KEYS, key)) {
      warn('Parameter "' + key + '" was not sent: DAMA rejects plain-text personal data. ' +
           'Use Customer Details instead.');
      return;
    }
    if (!isEmpty(params[key])) {
      target[key] = params[key];
    }
  });
}

function normalizeEcommerce(payload, eventName) {
  if (getType(payload.items) === 'string') {
    const parsedItems = JSON.parse(payload.items);
    if (getType(parsedItems) === 'array') {
      payload.items = parsedItems;
    } else {
      warn('Items is not a valid array, so it was not sent.');
      Object.delete(payload, 'items');
    }
  }
  if (getType(payload.value) === 'string') {
    const amount = makeNumber(payload.value);
    if (getType(amount) === 'number' && amount === amount) {
      payload.value = amount;
    } else {
      warn('Value "' + payload.value + '" is not a number, so it was not sent.');
      Object.delete(payload, 'value');
    }
  }
  if (!isEmpty(payload.currency)) {
    payload.currency = trim(payload.currency).toUpperCase();
    if (payload.currency.length !== 3) {
      warn('Currency "' + payload.currency + '" is not a three-letter ISO code; DAMA will reject this event.');
    }
  }
  if (eventName === 'purchase') {
    if (isEmpty(payload.transaction_id)) {
      warn('Purchase has no transaction_id.');
    } else {
      payload.transaction_id = makeString(payload.transaction_id);
      payload.event_transaction_id = payload.transaction_id;
    }
  }
  return payload;
}

function buildEcommercePayload(eventName) {
  const payload = {};
  if (data.useDataLayer === true) {
    const ecommerce = copyFromDataLayer('ecommerce', 2);
    if (getType(ecommerce) === 'object') {
      ECOMMERCE_KEYS.forEach(function (key) {
        if (!isEmpty(ecommerce[key])) {
          payload[key] = ecommerce[key];
        }
      });
    } else {
      warn('No ecommerce object in the data layer for ' + eventName + '. ' +
           'Push GA4 ecommerce data before this tag fires, or turn off "Read ecommerce data from the data layer".');
    }
  } else {
    if (!isEmpty(data.currency)) payload.currency = data.currency;
    if (!isEmpty(data.value)) payload.value = data.value;
    if (!isEmpty(data.items)) payload.items = data.items;
    if (eventName === 'purchase' && !isEmpty(data.transactionId)) {
      payload.transaction_id = data.transactionId;
    }
  }
  addParams(payload, data.eventParams);
  return normalizeEcommerce(payload, eventName);
}

function buildCustomerData() {
  const customer = {};
  const fields = [
    ['customerEmail', 'user_email'],
    ['customerPhone', 'user_phone'],
    ['customerFirstName', 'user_first_name'],
    ['customerLastName', 'user_last_name'],
    ['customerId', 'user_id']
  ];
  fields.forEach(function (field) {
    const fieldValue = trim(data[field[0]]);
    if (fieldValue) {
      customer[field[1]] = fieldValue;
    }
  });
  if (getType(data.userFields) === 'array' && data.userFields.length > 0) {
    const extra = makeTableMap(data.userFields, 'name', 'value') || {};
    Object.keys(extra).forEach(function (key) {
      if (key.indexOf('user_') === 0 && !isEmpty(extra[key])) {
        customer[key] = extra[key];
      }
    });
  }
  return customer;
}

const eventType = data.eventType || 'init';

if (eventType === 'init') {
  runBaseTag();
} else if (eventType === 'user_data') {
  const customer = buildCustomerData();
  if (Object.keys(customer).length === 0) {
    fail('Identify Customer has no customer details to send. Fill in at least the email.');
  } else {
    withSdk(function () {
      send('userDataPush', customer);
      data.gtmOnSuccess();
    });
  }
} else if (contains(ECOMMERCE_EVENTS, eventType)) {
  // Read everything now: the data layer may change while the SDK loads.
  const ecommercePayload = buildEcommercePayload(eventType);
  const checkoutCustomer = contains(CUSTOMER_EVENTS, eventType) ? buildCustomerData() : {};
  withSdk(function () {
    if (Object.keys(checkoutCustomer).length > 0) {
      send('userDataPush', checkoutCustomer);
    }
    send('event', eventType, ecommercePayload);
    data.gtmOnSuccess();
  });
} else if (eventType === 'custom') {
  const customEventName = trim(data.customEventName);
  if (!customEventName) {
    fail('Custom Event has no event name.');
  } else {
    const customPayload = {};
    addParams(customPayload, data.eventParams);
    withSdk(function () {
      send('event', customEventName, customPayload);
      data.gtmOnSuccess();
    });
  }
} else {
  fail('Unknown tag type "' + eventType + '".');
}


