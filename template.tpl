scenarios:
- name: Base tag loads the SDK with settings and consent
  code: |-
    runCode(mockData);

    assertThat(injectedUrls).hasLength(1);
    assertThat(injectedUrls[0]).isEqualTo('https://cdn.usedama.com/dama.js' +
      '?id=ORG-1&token=tok-1&collect=https%3A%2F%2Fcollect.example.com' +
      '&consents=true,true,true');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Base tag strips trailing slashes and reads denied consent
  code: |-
    mockData.collectUrl = 'https://collect.example.com//';
    mock('isConsentGranted', function (type) { return type === 'analytics_storage'; });

    runCode(mockData);

    assertThat(injectedUrls[0]).contains('&collect=https%3A%2F%2Fcollect.example.com&');
    assertThat(injectedUrls[0]).contains('&consents=true,false,true');
- name: Base tag uses manual consent values
  code: |-
