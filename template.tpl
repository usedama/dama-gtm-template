    runCode({eventType: 'custom', customEventName: 'newsletter_signup', gtmOnSuccess: function () {}, gtmOnFailure: function () {}});

    assertThat(injectedUrls).hasLength(2);
    assertThat(injectedUrls[1]).isEqualTo(injectedUrls[0]);
    assertThat(queue).hasLength(0);

